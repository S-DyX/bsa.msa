<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Description>Micro service architecture using the rabbitmq message broker.</Description>
    <Copyright>Stanislav Batyrgareev</Copyright>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageProjectUrl>http://bsasearch.org/msa.html</PackageProjectUrl>
    <RepositoryUrl>https://github.com/S-DyX/bsa.msa</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>MSA Rabbit MQ RabbiMQ RMQ Queue Message Bsa</PackageTags>
    <PackageReleaseNotes>{ "name": "Nightly",  "type": "ReindexCommand", "schedule": "daily",   "at": "23:59" }
{ "name": "Report",   "type": "ReportCommand",  "schedule": "weekly",  "days": "Monday;Thursday", "at": "02:00;14:00" }
{ "name": "Billing",  "type": "BillingCommand", "schedule": "monthly", "daysOfMonth": "1;15;-1", "at": "23:59" }
{ "name": "NightSync","type": "SyncCommand",    "period": "00:10:00", "from": "23:59", "to": "06:00", "days": "WorkingDays" }
{ "name": "Legacy",   "type": "ExampleCommand", "period": "00:05:00", "start": "14:00:00" }</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Version>6.0.82</Version>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
    <Authors>Stanislav Batyrgareev</Authors>
    <UserSecretsId>f8fa65d8-3211-4a53-80c0-d6f3de749ad2</UserSecretsId>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="6.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bsa.Msa.RabbitMq.Core.Tests" />
  </ItemGroup>
</Project>
