<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <Description>integrating Autofac with MSA Bsa.Msa.RabbitMq.Core
http://bsasearch.org/msa.html</Description>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <RepositoryType>Git</RepositoryType>
    <Copyright>Stanislav Batyrgareev</Copyright>
    <RepositoryUrl>https://bitbucket.org/SBatyrgareev/bsa.msa/src</RepositoryUrl>
    <PackageProjectUrl>https://github.com/S-DyX/bsa.msa</PackageProjectUrl>
    <PackageTags>MSA Rabbit MQ RabbiMQ RMQ Bsa.Msa.RabbitMq.Core Bsa</PackageTags>
    <PackageReleaseNotes>Added async message handler
 public sealed class EmptyMessageHandlerAsync : IMessageHandlerAsync&lt;EmptyMessage&gt;
 {
     private readonly IBusManager _busManager;
     private readonly ISettings _settings;

     public EmptyMessageHandlerAsync(IBusManager busManager, ISettings settings)
     {
         this._busManager = busManager;
         this._settings = settings;
     }
     public async Task HandleAsync(EmptyMessage message)
     {
         Console.Write($"Processed: {JsonConvert.SerializeObject(message)}");
         await Task.Delay(1000);

     }
 }</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Version>10.0.84</Version>
    <AssemblyVersion></AssemblyVersion>
    <Authors>Stanislav Batyrgareev</Authors>
    <FileVersion></FileVersion>
    <UserSecretsId>296ee702-81ce-4c22-9442-6b72b65466bd</UserSecretsId>
    <PackageId></PackageId>
    <Title></Title>
  </PropertyGroup>

  <!-- The core: by default the project of this repository (dotnet pack turns the reference into
       a dependency on the package of the same version); -p:UseCorePackage=true uses the published package. -->
  <PropertyGroup>
    <UseCorePackage Condition="'$(UseCorePackage)' == ''">false</UseCorePackage>
    <CorePackageVersion>10.0.84</CorePackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseCorePackage)' != 'true'">
    <ProjectReference Include="..\Bsa.Msa.RabbitMq.Core\Bsa.Msa.RabbitMq.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCorePackage)' == 'true'">
    <PackageReference Include="Bsa.Msa.RabbitMq.Core" Version="$(CorePackageVersion)" />
  </ItemGroup>
  <!-- Per platform: the newest package whose dependencies stay within the line of the platform
       (Autofac.Extensions.DependencyInjection 11.x needs Microsoft.Extensions 10.x, 9.x/10.x need 8.x) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="6.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="7.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.22" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

</Project>
