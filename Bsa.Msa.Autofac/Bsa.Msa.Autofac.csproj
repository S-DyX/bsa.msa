<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <Description>integrating Autofac with MSA Bsa.Msa.RabbitMq.Core
http://bsasearch.org/msa.html</Description>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <RepositoryType>Git</RepositoryType>
    <Copyright>Stanislav Batyrgareev</Copyright>
    <RepositoryUrl>https://bitbucket.org/SBatyrgareev/bsa.msa/src</RepositoryUrl>
    <PackageProjectUrl>https://github.com/S-DyX/bsa.msa</PackageProjectUrl>
    <PackageTags>MSA Rabbit MQ RabbiMQ RMQ Bsa.Msa.RabbitMq.Core Bsa</PackageTags>
    <PackageReleaseNotes>_singleRmqBus.Send("test.queue", exampleMessage, 10000);
now you can set ttl 10000 ms</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Version>10.0.84</Version>
    <AssemblyVersion></AssemblyVersion>
    <Authors>Stanislav Batyrgareev</Authors>
    <FileVersion></FileVersion>
    <UserSecretsId>296ee702-81ce-4c22-9442-6b72b65466bd</UserSecretsId>
  </PropertyGroup>

  <!-- The core as a package of the line of the platform: net6.0 -> 6.0.x, ..., net10.0 -> 10.0.x.
       The exact version [x]: a missing package fails the restore (NU1102) instead of taking the nearest
       higher version, which may belong to another line and have no assembly for the platform.
       -p:UseCoreProject=true uses the project of this repository instead (local development). -->
  <PropertyGroup>
    <CorePackagePatch Condition="'$(CorePackagePatch)' == ''">86</CorePackagePatch>
    <UseCoreProject Condition="'$(UseCoreProject)' == ''">false</UseCoreProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseCoreProject)' == 'true'">
    <ProjectReference Include="..\Bsa.Msa.RabbitMq.Core\Bsa.Msa.RabbitMq.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCoreProject)' != 'true' And '$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Bsa.Msa.RabbitMq.Core" Version="[6.0.$(CorePackagePatch)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCoreProject)' != 'true' And '$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="Bsa.Msa.RabbitMq.Core" Version="[7.0.$(CorePackagePatch)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCoreProject)' != 'true' And '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Bsa.Msa.RabbitMq.Core" Version="[8.0.$(CorePackagePatch)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCoreProject)' != 'true' And '$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Bsa.Msa.RabbitMq.Core" Version="[9.0.$(CorePackagePatch)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCoreProject)' != 'true' And '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Bsa.Msa.RabbitMq.Core" Version="[10.0.$(CorePackagePatch)]" />
  </ItemGroup>
  <!-- Per platform: the newest package whose dependencies stay within the line of the platform
       (Autofac.Extensions.DependencyInjection 11.x needs Microsoft.Extensions 10.x, 9.x/10.x need 8.x) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="6.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="7.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.22" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

</Project>
